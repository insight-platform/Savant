FROM python:3.10.12-slim

ARG PROJECT_PATH=/opt/savant
ENV PYTHONUNBUFFERED=1 \
    PROJECT_PATH=$PROJECT_PATH \
    PYTHONPATH=$PROJECT_PATH
WORKDIR $PROJECT_PATH

RUN export DEBIAN_FRONTEND=noninteractive && \
    apt-get update && \
    apt-get install --no-install-recommends -y \
        libmagic1 \
        build-essential \
        python3-dev && \
    rm -rf /var/lib/apt/lists/*

RUN --mount=type=bind,source=adapters/requirements.txt,target=/tmp/requirements.txt \
    python -m pip install --no-cache-dir -r /tmp/requirements.txt

RUN --mount=type=bind,source=adapters/requirements-py.txt,target=/tmp/requirements.txt \
    python -m pip install --no-cache-dir -r /tmp/requirements.txt

# install savant-rs
# TODO: Do not copy local wheels in image. Avoid SecretsUsedInArgOrEnv for "SAVANT_RS_GH_TOKEN"
ARG SAVANT_RS_VERSION
ARG SAVANT_RS_GH_REPO=insight-platform/savant-rs
ARG SAVANT_RS_GH_TOKEN
COPY local_wheels local_wheels
COPY utils/install_savant_rs.py utils/install_savant_rs.py
RUN ./utils/install_savant_rs.py $SAVANT_RS_VERSION ./utils && \
    rm -rf ./utils

COPY savant savant
COPY adapters/shared adapters/shared
COPY adapters/python adapters/python
ENV LOGLEVEL=info

ARG CYTHONIZE
RUN --mount=type=bind,source=utils/cythonize.sh,target=./cythonize.sh \
    if [[ -z "$CYTHONIZE" ]]; then ./cythonize.sh; fi

RUN echo 'python3 -c "from savant.utils.welcome import get_welcome_message; print(get_welcome_message())"' >> /etc/bash.bashrc
